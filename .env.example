# ─────────────────────────────────────────────────────────────
# CONSOLE INSURANCE — environment configuration (no real secrets here)
# Copy to .env.local for development, or set in your hosting dashboard.
# ─────────────────────────────────────────────────────────────

# Public canonical origin, no trailing slash. Used for metadata, sitemap, canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.example-console-insurance.co.ke

# Where validated enquiries are delivered (REQUIRED in production).
# The API POSTs JSON { type, receivedAt, data } to this URL with the bearer token below.
# Point it at your CRM, an automation tool (n8n / Make / Zapier), or a small mail relay you control.
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_TOKEN=

# Secret used to HMAC-hash client IPs for rate limiting / abuse logs (any long random string).
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional: set to "true" ONLY on a private staging site to store enquiries in a local JSONL file
# when no webhook is configured. Never enable on a public production site.
ALLOW_LOCAL_SUBMISSION_STORE=false

# Data-retention window (days) documented in the privacy page and applied by scripts/purge-submissions.mjs
SUBMISSION_RETENTION_DAYS=180
